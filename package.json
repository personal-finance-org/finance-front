{
  "name": "finanzas-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh": "ng build --base-href /finance-front/ && cp dist/finanzas-ui/browser/index.html dist/finanzas-ui/browser/404.html && touch dist/finanzas-ui/browser/.nojekyll",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "ng build && node scripts/preview.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
